{
  "name": "@limitboard/server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "PYTHONPATH=src:../../packages/quant-core/src python3 -m uvicorn limitboard_server.main:app --reload --host ${SERVER_HOST:-0.0.0.0} --port ${SERVER_PORT:-8000}",
    "build": "python3 -m compileall src && mkdir -p build && printf 'ok\\n' > build/server.buildstamp",
    "lint": "python3 -m compileall src",
    "typecheck": "python3 -m compileall src",
    "test": "PYTHONPATH=src:../../packages/quant-core/src python3 -m unittest discover -s tests -p 'test_*.py'"
  }
}
