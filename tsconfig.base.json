{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@limitboard/ui": ["packages/ui/src/index.ts"],
      "@limitboard/ui/*": ["packages/ui/src/*"],
      "@limitboard/db-types": ["packages/db-types/src/index.ts"]
    }
  }
}
